# ==============================================================================
# VERIPULSE CONFIGURATION
# Copy this file to .env and fill in the credentials you want to enable.
# ==============================================================================

# --- 1. AI Fact-Check & Zero-Fluff Synthesis (Gemini) ---
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 2. Telegram Alerts (Instant Real-Time Push) ---
# 1. Message @BotFather on Telegram -> /newbot -> copy the token
# 2. Message your bot and get your chat ID via https://api.telegram.org/bot<TOKEN>/getUpdates
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 3. Email Alerts (SMTP - Gmail / Outlook / Resend) ---
# For Gmail: Enable 2FA -> Google Account -> App Passwords -> generate 16-char password
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com

# --- 4. WhatsApp Alerts (Ready when you want to enable later) ---
# Supports "twilio" (Twilio WhatsApp Sandbox/API) or "meta" (Official Meta Cloud API)
ENABLE_WHATSAPP=false
WHATSAPP_PROVIDER=twilio
# Twilio settings:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+919876543210
# Meta Cloud API settings (optional alternative):
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# --- 5. Real-Time Watcher & Signal Thresholds ---
POLL_INTERVAL_SECONDS=300
MIN_TRUST_SCORE=65
MAX_ALERTS_PER_CYCLE=5
SUBREDDITS=worldnews,technology,science,geopolitics
MEDIUM_TAGS=technology,science,artificial-intelligence,world,cybersecurity
